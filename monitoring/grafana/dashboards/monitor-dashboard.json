{
  "uid": "pulsarops-monitor",
  "title": "PulsarOps — Monitor Service",
  "tags": ["pulsarops", "monitor-service"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Target Up / Down Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "monitor_target_up",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 2,
      "title": "Check Latency Heatmap per Target",
      "type": "heatmap",
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(monitor_check_duration_seconds_bucket[5m])) by (le, target)",
          "legendFormat": "{{target}} {{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ]
    },
    {
      "id": 3,
      "title": "Unhealthy Targets",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(monitor_target_up == 0) or vector(0)",
          "legendFormat": "unhealthy",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" },
          "unit": "short"
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 4,
      "title": "Total Checks (last 1h)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(increase(monitor_checks_total[1h]))",
          "legendFormat": "checks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "blue", "mode": "fixed" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none" }
    }
  ]
}
